{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kostja94/contextus/schemas/contextus-manifest.schema.json",
  "title": "Contextus Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "description", "type", "date", "contextus_version", "status", "visibility", "subject", "scope"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "type": { "const": "context" },
    "date": { "type": "string", "format": "date" },
    "contextus_version": { "const": 1 },
    "updated": { "type": "string", "format": "date" },
    "status": { "enum": ["active", "paused", "archived"] },
    "visibility": { "enum": ["public", "internal", "confidential"] },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["organization", "brand", "product", "product-line", "service", "platform", "open-source-project", "project"]
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["includes", "excludes"],
      "properties": {
        "includes": { "type": "array", "items": { "type": "string" } },
        "excludes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
